{
  "name": "@hzblj/expo-waveform",
  "version": "0.1.2",
  "description": "Native audio waveforms for Expo: analysed on the device (AVFoundation on iOS, MediaCodec on Android), cached, and drawn by a native view that follows playback at the display's frame rate, seeks by drag or tap with haptics, and meters a recording live.",
  "author": "Jan Blazej",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/expo-waveform.git",
    "directory": "packages/expo-waveform"
  },
  "bugs": {
    "url": "https://github.com/hzblj/expo-waveform/issues"
  },
  "homepage": "https://github.com/hzblj/expo-waveform#readme",
  "keywords": [
    "android",
    "audio",
    "expo",
    "expo-module",
    "ios",
    "podcast",
    "react-native",
    "scrubber",
    "seek-bar",
    "voice-message",
    "waveform"
  ],
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./expo-module.config.json": "./expo-module.config.json",
    "./package.json": "./package.json"
  },
  "files": [
    "android/build.gradle",
    "android/src/main/**",
    "build",
    "expo-module.config.json",
    "ios/*.podspec",
    "ios/*.swift",
    "ios/Core/**",
    "src"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p ./tsconfig.build.json",
    "clean": "rm -rf build",
    "prepack": "yarn run -T turbo run build --filter=$npm_package_name...",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "tsc -p ./tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:ios": "swift test --package-path ios/Tests",
    "test:android": "cd ../../apps/example/android && ./gradlew :hzblj-expo-waveform:testDebugUnitTest"
  },
  "peerDependencies": {
    "expo": ">=57",
    "expo-modules-core": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.14",
    "expo": "~57.0.31",
    "expo-modules-core": "~57.0.24",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
